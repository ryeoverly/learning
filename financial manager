<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Personal Finance</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
      background: #f5f5f3;
      color: #171717;
    }

    button,
    input,
    select {
      font: inherit;
    }

    .app {
      display: flex;
      min-height: 100vh;
    }

    /* SIDEBAR */

    .sidebar {
      width: 230px;
      background: #111;
      color: white;
      padding: 28px 18px;
      position: fixed;
      height: 100vh;
    }

    .logo {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 40px;
      padding-left: 10px;
    }

    .nav button {
      width: 100%;
      background: transparent;
      color: #aaa;
      border: none;
      text-align: left;
      padding: 12px 10px;
      border-radius: 8px;
      margin-bottom: 4px;
      cursor: pointer;
    }

    .nav button:hover,
    .nav button.active {
      background: #292929;
      color: white;
    }

    /* MAIN */

    .main {
      margin-left: 230px;
      width: calc(100% - 230px);
      padding: 35px;
      max-width: 1500px;
    }

    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    h1 {
      font-size: 28px;
      letter-spacing: -0.5px;
    }

    h2 {
      font-size: 18px;
      margin-bottom: 18px;
    }

    .subtitle {
      color: #777;
      margin-top: 5px;
    }

    /* CARDS */

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 25px;
    }

    .card {
      background: white;
      border: 1px solid #e7e7e5;
      border-radius: 14px;
      padding: 20px;
    }

    .card-label {
      font-size: 13px;
      color: #777;
      margin-bottom: 8px;
    }

    .card-value {
      font-size: 26px;
      font-weight: 650;
    }

    .positive {
      color: #16734b;
    }

    .negative {
      color: #b42318;
    }

    /* GRID */

    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 25px;
    }

    .panel {
      background: white;
      border: 1px solid #e7e7e5;
      border-radius: 14px;
      padding: 22px;
    }

    /* TABLE */

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th {
      text-align: left;
      color: #777;
      font-size: 12px;
      font-weight: 600;
      padding: 10px;
      border-bottom: 1px solid #eee;
    }

    td {
      padding: 13px 10px;
      border-bottom: 1px solid #f0f0ef;
      font-size: 14px;
    }

    /* BUTTONS */

    .btn {
      border: none;
      border-radius: 8px;
      padding: 10px 15px;
      cursor: pointer;
      background: #111;
      color: white;
      font-weight: 600;
    }

    .btn:hover {
      opacity: .85;
    }

    .btn-secondary {
      background: #eee;
      color: #111;
    }

    .delete {
      background: transparent;
      border: none;
      color: #b42318;
      cursor: pointer;
    }

    /* FORMS */

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .field label {
      font-size: 13px;
      color: #555;
    }

    input,
    select {
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 10px;
      background: white;
    }

    .form-actions {
      margin-top: 20px;
      display: flex;
      gap: 10px;
    }

    /* BUDGET */

    .budget-row {
      margin-bottom: 20px;
    }

    .budget-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 8px;
      font-size: 14px;
    }

    .progress {
      height: 9px;
      background: #eee;
      border-radius: 10px;
      overflow: hidden;
    }

    .progress-bar {
      height: 100%;
      background: #111;
      border-radius: 10px;
    }

    .progress-bar.warning {
      background: #d97706;
    }

    .progress-bar.danger {
      background: #b42318;
    }

    /* MOBILE */

    @media (max-width: 900px) {
      .sidebar {
        width: 70px;
      }

      .logo {
        font-size: 0;
      }

      .logo::after {
        content: "PF";
        font-size: 18px;
      }

      .nav button {
        font-size: 0;
        text-align: center;
      }

      .nav button::first-letter {
        font-size: 18px;
      }

      .main {
        margin-left: 70px;
        width: calc(100% - 70px);
        padding: 20px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .grid-2 {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- SIDEBAR -->

  <aside class="sidebar">
    <div class="logo">Personal Finance</div>

    <nav class="nav">
      <button class="active" onclick="showPage('dashboard', this)">Dashboard</button>
      <button onclick="showPage('transactions', this)">Transactions</button>
      <button onclick="showPage('accounts', this)">Accounts</button>
      <button onclick="showPage('budgets', this)">Budgets</button>
      <button onclick="showPage('goals', this)">Goals</button>
    </nav>
  </aside>


  <main class="main">

    <!-- DASHBOARD -->

    <section id="dashboard" class="page active">

      <div class="header">
        <div>
          <h1>Financial Dashboard</h1>
          <div class="subtitle">Your financial position at a glance.</div>
        </div>

        <button class="btn" onclick="showPage('transactions')">
          + Transaction
        </button>
      </div>

      <div class="cards">

        <div class="card">
          <div class="card-label">Net Worth</div>
          <div class="card-value" id="netWorth">$0</div>
        </div>

        <div class="card">
          <div class="card-label">Cash</div>
          <div class="card-value" id="cash">$0</div>
        </div>

        <div class="card">
          <div class="card-label">Investments</div>
          <div class="card-value" id="investments">$0</div>
        </div>

        <div class="card">
          <div class="card-label">Monthly Spending</div>
          <div class="card-value" id="monthlySpending">$0</div>
        </div>

      </div>


      <div class="grid-2">

        <div class="panel">
          <h2>Accounts</h2>

          <table>
            <thead>
              <tr>
                <th>Account</th>
                <th>Type</th>
                <th>Balance</th>
              </tr>
            </thead>

            <tbody id="dashboardAccounts"></tbody>
          </table>

        </div>


        <div class="panel">

          <h2>Monthly Spending</h2>

          <div id="dashboardBudgets"></div>

        </div>

      </div>


      <div class="panel">

        <h2>Recent Transactions</h2>

        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Description</th>
              <th>Category</th>
              <th>Amount</th>
            </tr>
          </thead>

          <tbody id="recentTransactions"></tbody>

        </table>

      </div>

    </section>


    <!-- TRANSACTIONS -->

    <section id="transactions" class="page">

      <div class="header">
        <div>
          <h1>Transactions</h1>
          <div class="subtitle">Track where your money goes.</div>
        </div>
      </div>


      <div class="panel">

        <h2>Add Transaction</h2>

        <div class="form-grid">

          <div class="field">
            <label>Date</label>
            <input type="date" id="transactionDate">
          </div>

          <div class="field">
            <label>Description</label>
            <input type="text" id="transactionDescription" placeholder="Groceries">
          </div>

          <div class="field">
            <label>Category</label>

            <select id="transactionCategory">

              <option>Housing</option>
              <option>Food</option>
              <option>Transportation</option>
              <option>Travel</option>
              <option>Shopping</option>
              <option>Entertainment</option>
              <option>Health</option>
              <option>Fitness</option>
              <option>Utilities</option>
              <option>Subscriptions</option>
              <option>Other</option>

            </select>

          </div>


          <div class="field">

            <label>Type</label>

            <select id="transactionType">

              <option value="expense">Expense</option>
              <option value="income">Income</option>

            </select>

          </div>


          <div class="field">

            <label>Amount</label>

            <input
              type="number"
              id="transactionAmount"
              placeholder="100"
              step="0.01"
            >

          </div>

        </div>


        <div class="form-actions">

          <button class="btn" onclick="addTransaction()">
            Add Transaction
          </button>

        </div>

      </div>


      <br>


      <div class="panel">

        <h2>All Transactions</h2>

        <table>

          <thead>
            <tr>
              <th>Date</th>
              <th>Description</th>
              <th>Category</th>
              <th>Type</th>
              <th>Amount</th>
              <th></th>
            </tr>
          </thead>

          <tbody id="transactionsTable"></tbody>

        </table>

      </div>

    </section>


    <!-- ACCOUNTS -->

    <section id="accounts" class="page">

      <div class="header">

        <div>

          <h1>Accounts</h1>

          <div class="subtitle">
            Track your complete financial balance sheet.
          </div>

        </div>

      </div>


      <div class="panel">

        <h2>Add Account</h2>

        <div class="form-grid">

          <div class="field">

            <label>Name</label>

            <input
              id="accountName"
              placeholder="Fidelity 401(k)"
            >

          </div>


          <div class="field">

            <label>Type</label>

            <select id="accountType">

              <option value="cash">Cash</option>
              <option value="investment">Investment</option>
              <option value="retirement">Retirement</option>
              <option value="credit">Credit</option>
              <option value="other">Other</option>

            </select>

          </div>


          <div class="field">

            <label>Balance</label>

            <input
              type="number"
              id="accountBalance"
              placeholder="10000"
              step="0.01"
            >

          </div>

        </div>


        <div class="form-actions">

          <button class="btn" onclick="addAccount()">
            Add Account
          </button>

        </div>

      </div>


      <br>


      <div class="panel">

        <h2>Your Accounts</h2>

        <table>

          <thead>

            <tr>
              <th>Account</th>
              <th>Type</th>
              <th>Balance</th>
              <th></th>
            </tr>

          </thead>

          <tbody id="accountsTable"></tbody>

        </table>

      </div>

    </section>


    <!-- BUDGETS -->

    <section id="budgets" class="page">

      <div class="header">

        <div>

          <h1>Budgets</h1>

          <div class="subtitle">
            Decide what your money should do before you spend it.
          </div>

        </div>

      </div>


      <div class="panel">

        <h2>Add Budget</h2>

        <div class="form-grid">

          <div class="field">

            <label>Category</label>

            <select id="budgetCategory">

              <option>Housing</option>
              <option>Food</option>
              <option>Transportation</option>
              <option>Travel</option>
              <option>Shopping</option>
              <option>Entertainment</option>
              <option>Health</option>
              <option>Fitness</option>
              <option>Utilities</option>
              <option>Subscriptions</option>
              <option>Other</option>

            </select>

          </div>


          <div class="field">

            <label>Monthly Budget</label>

            <input
              type="number"
              id="budgetAmount"
              placeholder="500"
              step="0.01"
            >

          </div>

        </div>


        <div class="form-actions">

          <button class="btn" onclick="addBudget()">
            Add Budget
          </button>

        </div>

      </div>


      <br>


      <div class="panel">

        <h2>Monthly Budgets</h2>

        <div id="budgetList"></div>

      </div>

    </section>


    <!-- GOALS -->

    <section id="goals" class="page">

      <div class="header">

        <div>

          <h1>Financial Goals</h1>

          <div class="subtitle">
            Turn long-term financial objectives into measurable targets.
          </div>

        </div>

      </div>


      <div class="panel">

        <h2>Add Goal</h2>

        <div class="form-grid">

          <div class="field">

            <label>Goal</label>

            <input
              id="goalName"
              placeholder="Emergency Fund"
            >

          </div>


          <div class="field">

            <label>Target</label>

            <input
              type="number"
              id="goalTarget"
              placeholder="25000"
            >

          </div>


          <div class="field">

            <label>Current Amount</label>

            <input
              type="number"
              id="goalCurrent"
              placeholder="10000"
            >

          </div>

        </div>


        <div class="form-actions">

          <button class="btn" onclick="addGoal()">
            Add Goal
          </button>

        </div>

      </div>


      <br>


      <div class="panel">

        <h2>Your Goals</h2>

        <div id="goalList"></div>

      </div>

    </section>

  </main>

</div>


<script>

/* =========================================================
   DATA
========================================================= */

let data = JSON.parse(
  localStorage.getItem("personalFinance")
) || {

  accounts: [],

  transactions: [],

  budgets: [],

  goals: []

};


/* =========================================================
   STORAGE
========================================================= */

function save() {

  localStorage.setItem(
    "personalFinance",
    JSON.stringify(data)
  );

}


/* =========================================================
   UTILITIES
========================================================= */

function money(value) {

  return new Intl.NumberFormat(
    "en-US",
    {
      style: "currency",
      currency: "USD"
    }
  ).format(value);

}


function today() {

  return new Date()
    .toISOString()
    .split("T")[0];

}


/* =========================================================
   NAVIGATION
========================================================= */

function showPage(page, button) {

  document
    .querySelectorAll(".page")
    .forEach(p => p.classList.remove("active"));

  document
    .getElementById(page)
    .classList.add("active");


  document
    .querySelectorAll(".nav button")
    .forEach(b => b.classList.remove("active"));

  if (button) {
    button.classList.add("active");
  }

  render();

}


/* =========================================================
   ACCOUNTS
========================================================= */

function addAccount() {

  const name =
    document.getElementById("accountName").value;

  const type =
    document.getElementById("accountType").value;

  const balance =
    Number(
      document.getElementById("accountBalance").value
    );


  if (!name || !balance) {

    alert("Enter an account and balance.");

    return;

  }


  data.accounts.push({

    id: Date.now(),

    name,

    type,

    balance

  });


  save();

  document.getElementById("accountName").value = "";

  document.getElementById("accountBalance").value = "";

  render();

}


function deleteAccount(id) {

  data.accounts =
    data.accounts.filter(
      account => account.id !== id
    );

  save();

  render();

}


/* =========================================================
   TRANSACTIONS
========================================================= */

function addTransaction() {

  const date =
    document.getElementById("transactionDate").value ||
    today();

  const description =
    document
      .getElementById("transactionDescription")
      .value;

  const category =
    document
      .getElementById("transactionCategory")
      .value;

  const type =
    document
      .getElementById("transactionType")
      .value;

  const amount =
    Number(
      document
        .getElementById("transactionAmount")
        .value
    );


  if (!description || !amount) {

    alert("Enter a description and amount.");

    return;

  }


  data.transactions.push({

    id: Date.now(),

    date,

    description,

    category,

    type,

    amount

  });


  save();


  document
    .getElementById("transactionDescription")
    .value = "";

  document
    .getElementById("transactionAmount")
    .value = "";


  render();

}


function deleteTransaction(id) {

  data.transactions =
    data.transactions.filter(
      transaction =>
        transaction.id !== id
    );

  save();

  render();

}


/* =========================================================
   BUDGETS
========================================================= */

function addBudget() {

  const category =
    document
      .getElementById("budgetCategory")
      .value;

  const amount =
    Number(
      document
        .getElementById("budgetAmount")
        .value
    );


  if (!amount) {

    alert("Enter a budget.");

    return;

  }


  data.budgets.push({

    id: Date.now(),

    category,

    amount

  });


  save();


  document
    .getElementById("budgetAmount")
    .value = "";


  render();

}


/* =========================================================
   GOALS
========================================================= */

function addGoal() {

  const name =
    document
      .getElementById("goalName")
      .value;

  const target =
    Number(
      document
        .getElementById("goalTarget")
        .value
    );

  const current =
    Number(
      document
        .getElementById("goalCurrent")
        .value
    );


  if (!name || !target) {

    alert("Enter a goal and target.");

    return;

  }


  data.goals.push({

    id: Date.now(),

    name,

    target,

    current

  });


  save();


  document.getElementById("goalName").value = "";

  document.getElementById("goalTarget").value = "";

  document.getElementById("goalCurrent").value = "";


  render();

}


/* =========================================================
   CALCULATIONS
========================================================= */

function calculateNetWorth() {

  return data.accounts.reduce(
    (total, account) =>
      total + account.balance,
    0
  );

}


function calculateCash() {

  return data.accounts

    .filter(
      account =>
        account.type === "cash"
    )

    .reduce(
      (total, account) =>
        total + account.balance,
      0
    );

}


function calculateInvestments() {

  return data.accounts

    .filter(
      account =>
        account.type === "investment" ||
        account.type === "retirement"
    )

    .reduce(
      (total, account) =>
        total + account.balance,
      0
    );

}


function calculateMonthlySpending() {

  const now = new Date();

  const month =
    now.getMonth();

  const year =
    now.getFullYear();


  return data.transactions

    .filter(transaction => {

      const date =
        new Date(transaction.date);

      return (
        transaction.type === "expense" &&
        date.getMonth() === month &&
        date.getFullYear() === year
      );

    })

    .reduce(
      (total, transaction) =>
        total + transaction.amount,
      0
    );

}


function categorySpending(category) {

  return data.transactions

    .filter(transaction =>
      transaction.type === "expense" &&
      transaction.category === category
    )

    .reduce(
      (total, transaction) =>
        total + transaction.amount,
      0
    );

}


/* =========================================================
   RENDER DASHBOARD
========================================================= */

function renderDashboard() {

  document.getElementById(
    "netWorth"
  ).textContent =
    money(calculateNetWorth());


  document.getElementById(
    "cash"
  ).textContent =
    money(calculateCash());


  document.getElementById(
    "investments"
  ).textContent =
    money(calculateInvestments());


  document.getElementById(
    "monthlySpending"
  ).textContent =
    money(calculateMonthlySpending());


  const accounts =
    document.getElementById(
      "dashboardAccounts"
    );


  accounts.innerHTML =
    data.accounts.map(account => `

      <tr>

        <td>${account.name}</td>

        <td>${account.type}</td>

        <td>${money(account.balance)}</td>

      </tr>

    `).join("");


  const recent =
    [...data.transactions]
      .sort(
        (a,b) =>
          new Date(b.date) -
          new Date(a.date)
      )
      .slice(0, 8);


  document.getElementById(
    "recentTransactions"
  ).innerHTML =

    recent.map(transaction => `

      <tr>

        <td>${transaction.date}</td>

        <td>${transaction.description}</td>

        <td>${transaction.category}</td>

        <td class="${
          transaction.type === "income"
            ? "positive"
            : "negative"
        }">

          ${
            transaction.type === "income"
              ? "+"
              : "-"
          }${money(transaction.amount)}

        </td>

      </tr>

    `).join("");


  renderBudgetBars(
    "dashboardBudgets"
  );

}


/* =========================================================
   RENDER TRANSACTIONS
========================================================= */

function renderTransactions() {

  document.getElementById(
    "transactionsTable"
  ).innerHTML =

    [...data.transactions]

      .sort(
        (a,b) =>
          new Date(b.date) -
          new Date(a.date)
      )

      .map(transaction => `

        <tr>

          <td>${transaction.date}</td>

          <td>${transaction.description}</td>

          <td>${transaction.category}</td>

          <td>${transaction.type}</td>

          <td class="${
            transaction.type === "income"
              ? "positive"
              : "negative"
          }">

            ${
              transaction.type === "income"
                ? "+"
                : "-"
            }${money(transaction.amount)}

          </td>

          <td>

            <button
              class="delete"
              onclick="deleteTransaction(${transaction.id})"
            >
              Delete
            </button>

          </td>

        </tr>

      `).join("");

}


/* =========================================================
   RENDER ACCOUNTS
========================================================= */

function renderAccounts() {

  document.getElementById(
    "accountsTable"
  ).innerHTML =

    data.accounts.map(account => `

      <tr>

        <td>${account.name}</td>

        <td>${account.type}</td>

        <td>${money(account.balance)}</td>

        <td>

          <button
            class="delete"
            onclick="deleteAccount(${account.id})"
          >
            Delete
          </button>

        </td>

      </tr>

    `).join("");

}


/* =========================================================
   RENDER BUDGETS
========================================================= */

function renderBudgetBars(containerId) {

  const container =
    document.getElementById(
      containerId
    );


  container.innerHTML =

    data.budgets.map(budget => {

      const spent =
        categorySpending(
          budget.category
        );


      const percent =
        Math.min(
          (spent / budget.amount) * 100,
          100
        );


      let status = "";

      if (percent >= 100) {

        status = "danger";

      } else if (percent >= 80) {

        status = "warning";

      }


      return `

        <div class="budget-row">

          <div class="budget-header">

            <span>
              ${budget.category}
            </span>

            <span>
              ${money(spent)}
              /
              ${money(budget.amount)}
            </span>

          </div>


          <div class="progress">

            <div
              class="progress-bar ${status}"
              style="width:${percent}%"
            ></div>

          </div>

        </div>

      `;

    }).join("");

}


function renderBudgets() {

  renderBudgetBars(
    "budgetList"
  );

}


/* =========================================================
   RENDER GOALS
========================================================= */

function renderGoals() {

  document.getElementById(
    "goalList"
  ).innerHTML =

    data.goals.map(goal => {

      const percent =
        Math.min(
          (goal.current / goal.target) * 100,
          100
        );


      return `

        <div class="budget-row">

          <div class="budget-header">

            <strong>
              ${goal.name}
            </strong>

            <span>
              ${money(goal.current)}
              /
              ${money(goal.target)}
            </span>

          </div>


          <div class="progress">

            <div
              class="progress-bar"
              style="width:${percent}%"
            ></div>

          </div>

          <div
            style="
              margin-top:6px;
              color:#777;
              font-size:13px;
            "
          >

            ${Math.round(percent)}% complete

          </div>

        </div>

      `;

    }).join("");

}


/* =========================================================
   MASTER RENDER
========================================================= */

function render() {

  renderDashboard();

  renderTransactions();

  renderAccounts();

  renderBudgets();

  renderGoals();

}


/* =========================================================
   INITIALIZE
========================================================= */

document.getElementById(
  "transactionDate"
).value = today();

render();

</script>

</body>
</html>
